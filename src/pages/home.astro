---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import { getFeaturedProducts, getCollabs } from "../lib/sanity-client.ts";
import Carousel from "../components/Carousel.astro";

import aboutMe from "../assets/images/web/about-home.png";
import logoFallback from "../assets/images/web/logo_fallback.png";
import collabFallback from "../assets/images/web/dreams.png";
import footerImage from "../assets/images/web/Hero_Image.png";

// Fetch featured products from Sanity
const featuredProducts = await getFeaturedProducts();
const collabs = await getCollabs();

const featuredSlides = featuredProducts
  .filter((p) => p.images?.[0])
  .map((p) => ({
    productId: p._id,
    image: p.images[0],
    title: p.name,
    link: `/products/${p.slug}`,
  }));

const collabSlides = collabs
  .filter((c) => c.images?.[0])
  .map((c) => ({
    image: c.images[0],
    title: c.title,
  }));

const pageTitle = "Home | VANGULAR";
const keywords =
  "Vangular, home, welcome, art, design, portfolio, creative, vibrant, spiritual";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <!-- Welcome/Hero Section -->
    <section class="section hero-section">
      <div class="hero-image img-skeleton">
        <Image
          src={footerImage}
          alt="VANGULAR artwork"
          widths={[800, 1200, 1600]}
          sizes="100vw"
          data-fallback={logoFallback.src}
          data-img-fade
        />
      </div>
      <div class="overlay-text column flex-center">
        <p class="description">Welcome to</p>
        <h1 class="title">Vangular</h1>
        <p class="description">
          Art and Designs for the Existential and Absurd
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container grid-responsive">
        <div
          class:list={[
            "image-container",
            featuredSlides.length === 0 && "img-skeleton",
          ]}
        >
          {
            featuredSlides.length > 0 ? (
              <Carousel
                items={featuredSlides}
                id="featured-art"
                fallback={logoFallback.src}
              />
            ) : (
              <Image
                src={logoFallback}
                alt="Featured Artwork"
                widths={[400, 600, 800]}
                sizes="(max-width: 768px) 100vw, 50vw"
                data-fallback={logoFallback.src}
                data-img-fade
              />
            )
          }
        </div>

        <div class="text-container">
          <h3>Featured Artwork</h3>
          <br />
          <p>
            Take a look at some of my featured artwork! I get inspiration from
            nature and the world around me. I hope you find something that
            inspires you too!
          </p>
          <br />
          <div class="button-group">
            <a href="/shop" class="button button-secondary">
              <span class="button-label">Shop Art</span>
            </a>
          </div>
        </div>
      </div>

      <div class="container grid-responsive reverse-layout">
        <div class="image-container image-container--bottom img-skeleton">
          <Image
            src={aboutMe}
            alt="Image of the artist VANGULAR aka Valerie Angulo"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            data-fallback={logoFallback.src}
            data-img-fade
          />
        </div>

        <div class="text-container">
          <h3>About Vangular</h3>
          <br />
          <p>
            Hey I'm Val and welcome to VANGULAR! Vangular is a space for art and
            designs that I wish to share with the world :)
          </p>
          <br />
          <div class="button-group">
            <a href="/about" class="button button-secondary">
              <span class="button-label">Learn More</span>
            </a>
          </div>
        </div>
      </div>

      <div class="container grid-responsive">
        <div
          class:list={[
            "image-container",
            collabSlides.length === 0 && "img-skeleton",
          ]}
        >
          {
            collabSlides.length > 0 ? (
              <Carousel
                items={collabSlides}
                id="collabs"
                fallback={collabFallback.src}
                imageFallback={logoFallback.src}
              />
            ) : (
              <Image
                src={collabFallback}
                alt="EmmaLee Collaboration"
                widths={[400, 600, 800]}
                sizes="(max-width: 768px) 100vw, 50vw"
                data-fallback={logoFallback.src}
                data-img-fade
              />
            )
          }
        </div>

        <div class="text-container">
          <h3>Collabs & Commissions</h3>
          <br />
          <p>
            I believe that collaborations are a powerful way to connect and
            create together. If you're interested in collaborating, please reach
            out!
          </p>
          <br />
          <div class="button-group">
            <a href="/info/contact" class="button button-secondary">
              <span class="button-label">Collaborate</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
