---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LastUpdated from "../../components/LastUpdated.astro";

const pageTitle = "Shipping & Returns | VANGULAR";
const keywords = "Shipping, Returns, VANGULAR, delivery, exchange";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <section class="section">
      <div class="container column flex-center">
        <h2>Shipping & Returns</h2>

        <h3>Processing Times</h3>
        <p>
          Orders are processed within 1-3 business days after payment
          confirmation. During peak seasons or promotional periods, processing
          may take up to 5 business days. You will receive a confirmation email
          once your order ships.
        </p>

        <h3>Domestic Shipping</h3>
        <p>
          We ship via USPS and UPS. Standard shipping takes 3-7 business days
          within the US. Expedited options are available at checkout. Free
          standard shipping on orders over $75.
        </p>

        <h3>International Shipping</h3>
        <p>
          We ship worldwide. International delivery typically takes 7-21
          business days depending on the destination and customs processing.
          Shipping costs are calculated at checkout based on weight and
          destination. Buyers are responsible for any customs duties or import
          taxes.
        </p>

        <h3>Tracking</h3>
        <p>
          All orders include tracking information sent to your email. Allow
          24-48 hours after shipment for tracking to update. If your tracking
          has not updated within 5 business days, please contact us.
        </p>

        <h3>Packaging</h3>
        <p>
          Artworks are packaged with care using rigid mailers, tissue paper, and
          protective sleeves. Prints are shipped flat in reinforced envelopes.
          Fragile items include extra padding and "fragile" labeling.
        </p>

        <h3>Returns & Exchanges</h3>
        <p>
          We accept returns within 14 days of delivery. Items must be unused and
          in original condition. To initiate a return, contact us with your
          order number. Return shipping costs are the responsibility of the
          buyer unless the item arrived damaged or incorrect.
        </p>

        <h3>Damaged or Incorrect Items</h3>
        <p>
          If your order arrives damaged or incorrect, please contact us within
          48 hours of delivery with photos. We will arrange a replacement or
          full refund including return shipping costs. <br /> "I'll always do my best
          to make things right if there's an issue with your order, but I can't be
          responsible for delays or damage once a package is in the hands of the shipping
          carrier."
        </p>

        <h3>Digital Product Delivery</h3>
        <p>
          Digital products are available for immediate download after purchase.
          A download link will also be sent to your email. Due to the nature of
          digital goods, all digital sales are final.
        </p>

        <p>
          If you have any questions that are not answered here, please reach out
          to us at <a class="link" href="mailto:support@vangular.com"
            >support@vangular.com</a
          >.
        </p>

        <LastUpdated fileUrl={import.meta.url} />
      </div>
    </section>
  </main>
</BaseLayout>
