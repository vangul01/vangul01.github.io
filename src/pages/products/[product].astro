---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { MAX_QUANTITY } from "../../lib/commerce-config";
import { client, getOptimizedImageUrl } from "../../lib/sanity-client";
import type { Product } from "../../types/sanity-schema";
import missingProductFallback from "../../assets/images/web/missing-product-fallback.png";

export async function getStaticPaths() {
  const query = `*[_type == "product" && _id match "prod_*"]{
    _id,
    "slug": slug.current,
    name,
    description,
    materials,
    dimensions,
    "images": images[].asset->url,
    category,
    featured
  }`;

  const products = (await client.fetch(query)) as Product[];

  return products.map((product: Product) => ({
    params: { product: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const pageTitle = `${product.name} | VANGULAR`;
const keywords = `vangular, ${product.name}, art, products`;

const descriptionLines = (product.description || "")
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean);
const descriptionParagraphs = descriptionLines.filter(
  (line) => !/^[-*]\s+/.test(line),
);
const description =
  descriptionParagraphs[0] ||
  `Shop ${product.name} by VANGULAR, a unique piece of art and design.`;
const ogImage = product.images?.[0]
  ? getOptimizedImageUrl(product.images[0], 1200)
  : "/images/preview-image.png";
const specBullets = [
  ...descriptionLines
    .filter((line) => /^[-*]\s+/.test(line))
    .map((line) => line.replace(/^[-*]\s+/, "")),
  product.materials ? `materials: ${product.materials}` : "",
  product.dimensions ? `dimensions: ${product.dimensions}` : "",
].filter(Boolean);
---

<BaseLayout
  pageTitle={pageTitle}
  keywords={keywords}
  description={description}
  ogImage={ogImage}
>
  <main>
    <section class="section" id="product-page">
      <div
        class="container grid-responsive is-loading product-layout"
        data-product-root
        data-product-id={product._id}
      >
        <div class="container clear product-images" data-product-images>
          <div class="product-image-stage img-skeleton">
            <img
              id="main-product-image"
              src={product.images?.[0]
                ? getOptimizedImageUrl(product.images[0], 1200)
                : missingProductFallback.src}
              alt={product.name}
              loading="eager"
              data-fallback={missingProductFallback.src}
              data-img-fade
            />
          </div>

          {
            product.images?.length > 1 && (
              <div
                class="product-thumbnails"
                role="group"
                aria-label="Product images"
              >
                {product.images.map((imageUrl, index) => (
                  <button
                    type="button"
                    class:list={["thumbnail-button", { active: index === 0 }]}
                    aria-label={`Show image ${index + 1} of ${product.images.length}`}
                    aria-pressed={index === 0}
                    data-index={index}
                  >
                    <img
                      src={getOptimizedImageUrl(imageUrl, 200)}
                      alt=""
                      class="thumbnail"
                      data-image-url={getOptimizedImageUrl(imageUrl, 1200)}
                      loading="lazy"
                      data-fallback={missingProductFallback.src}
                      data-img-fade
                    />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="container clear product-text" data-product-details>
          <h3>{product.name}</h3>

          <p
            id="product-price"
            class="product-price skeleton-text"
            data-product-id={product._id}
            aria-busy="true"
          >
            &nbsp;
          </p>

          <p
            class="product-badge product-status"
            data-availability-status
            hidden
          >
          </p>

          <div class="product-quantity" data-product-quantity>
            <span class="quantity-label" id="product-quantity-label"
              >Quantity</span
            >
            <div class="quantity-controls">
              <button
                type="button"
                class="quantity-btn"
                data-quantity-change="-1"
                aria-label="Decrease quantity"
                disabled
              >
                −
              </button>
              <input
                type="number"
                class="quantity-value"
                id="product-quantity"
                data-quantity-input
                min="1"
                max={MAX_QUANTITY}
                value="1"
                inputmode="numeric"
                aria-labelledby="product-quantity-label"
                disabled
              />
              <button
                type="button"
                class="quantity-btn"
                data-quantity-change="1"
                aria-label="Increase quantity"
                disabled
              >
                +
              </button>
            </div>
          </div>

          <div class="button-group" data-product-actions>
            <button
              class="button button-disable button-check skeleton-button"
              id="add-to-cart"
              data-product-id={product._id}
              data-name={product.name}
              data-image={product.images?.[0] || ""}
              data-product-url={`${product.slug}`}
              disabled
              aria-busy="true"
            >
              <span class="button-label">&nbsp;</span>
            </button>
          </div>

          <div class="product-description">
            {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            {
              specBullets.length > 0 && (
                <ul class="product-specs">
                  {specBullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )
            }
          </div>

          <p class="product-note product-returns-note">
            We offer free returns for a full refund within 30 days of when you
            receive your package. <a href="/info/shipping">Learn more</a>
          </p>

          <p class="product-note">Tax and shipping calculated at checkout</p>
        </div>
      </div>

      <span
        class="visually-hidden"
        role="status"
        aria-live="polite"
        data-product-feedback></span>

      <div class="container" data-product-unavailable hidden>
        <h3>This piece is no longer available</h3>
        <div class="button-group">
          <a href="/shop" class="button button-primary">
            <span class="button-label">Return to shop</span>
          </a>
        </div>
      </div>

      <div class="container clear">
        <div class="button-group">
          <button type="button" class="button button-tertiary" data-back-link>
            <span class="button-label">Go Back</span>
          </button>
          <a href="/shop" class="button button-secondary">
            <span class="button-label">Keep Shopping</span>
          </a>
          <a href="/cart" class="button button-primary">
            <span class="button-label">View Cart</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
