---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { client, getOptimizedImageUrl } from "../../lib/sanity-client";
import type { Product } from "../../types/sanity-schema";
import missingProductFallback from "../../assets/images/web/missing_product_fallback.png";

export async function getStaticPaths() {
  const query = `*[_type == "product" && _id match "prod_*"]{
    _id,
    "slug": slug.current,
    name,
    description,
    materials,
    dimensions,
    "images": images[].asset->url,
    category,
    featured
  }`;

  const products = (await client.fetch(query)) as Product[];

  return products.map((product: Product) => ({
    params: { product: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const pageTitle = `${product.name} | VANGULAR`;
const keywords = `vangular, ${product.name}, art, products`;
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <section class="section" id="product-page">
      <div class="container grid-responsive is-loading" data-product-root data-product-id={product._id}>
        <div class="container product-images" data-product-images>
          <div class="product-image-stage img-skeleton">
            <img
              id="main-product-image"
              src={product.images?.[0]
                ? getOptimizedImageUrl(product.images[0], 800)
                : missingProductFallback.src}
              alt={product.name}
              loading="eager"
              data-fallback={missingProductFallback.src}
              data-img-fade
            />
          </div>

          {
            product.images?.length > 1 && (
              <div class="product-thumbnails" role="list">
                {product.images.map((imageUrl, index) => (
                  <img
                    src={getOptimizedImageUrl(imageUrl, 150)}
                    alt={`${product.name} view ${index + 1}`}
                    class={`thumbnail ${index === 0 ? "active" : ""}`}
                    data-image-url={getOptimizedImageUrl(imageUrl, 800)}
                    data-index={index}
                    loading="lazy"
                    data-fallback={missingProductFallback.src}
                    data-img-fade
                  />
                ))}
              </div>
            )
          }
        </div>

        <div class="container product-text" data-product-details>
          <h3>{product.name}</h3>

          <p id="product-price" class="product-price skeleton-text" data-product-id={product._id} aria-busy="true">
            &nbsp;
          </p>

          <p class="product-status" data-availability-status hidden></p>

          <div class="button-group" data-product-actions>
            <button
              class="button button-disable button-check skeleton-button"
              id="add-to-cart"
              data-product-id={product._id}
              data-name={product.name}
              data-image={product.images?.[0] || ""}
              data-product-url={`${product.slug}`}
              disabled
              aria-busy="true"
            >
              <span class="button-label">&nbsp;</span>
            </button>
          </div>

          <p class="product-description">{product.description}</p>

          {
            (product.materials || product.dimensions) && (
              <div class="product-details">
                <h4>Details</h4>
                <dl>
                  {product.materials && (
                    <div>
                      <dt>Materials</dt>
                      <dd>{product.materials}</dd>
                    </div>
                  )}
                  {product.dimensions && (
                    <div>
                      <dt>Dimensions</dt>
                      <dd>{product.dimensions}</dd>
                    </div>
                  )}
                </dl>
              </div>
            )
          }
        </div>
      </div>

      <div class="container" data-product-unavailable hidden>
        <h3>This piece is no longer available</h3>
        <div class="button-group">
          <a href="/shop" class="button button-primary">
            <span class="button-label">Return to shop</span>
          </a>
          <a href="/cart" class="button button-secondary">
            <span class="button-label">Go To Cart</span>
          </a>
        </div>
      </div>

      <div class="container">
        <div class="button-group">
          <a href="/shop" data-back-link>
            <button class="button button-tertiary">
              <span class="button-label">Go Back</span>
            </button>
          </a>
          <a href="/shop">
            <button class="button button-secondary">
              <span class="button-label">Keep Shopping</span>
            </button>
          </a>
          <a href="/cart">
            <button class="button button-primary">
              <span class="button-label">Go To Cart</span>
            </button>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
