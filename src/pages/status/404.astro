---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "404 | VANGULAR";
const keywords = "404 error";
const description =
  "The page you were looking for could not be found on VANGULAR.";
---

<BaseLayout
  pageTitle={pageTitle}
  keywords={keywords}
  description={description}
  noindex={true}
>
  <main>
    <section class="section">
      <div class="container column flex-center">
        <h2>404</h2>
        <h4>Page not found. <br /> Blasted broken link!</h4>
        <div class="button-group">
          <a href="/home" class="button button-tertiary">
            <span class="button-label">Back to Vangular</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
