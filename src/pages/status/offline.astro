---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "You're offline | VANGULAR";
const keywords = "offline, no internet connection, PWA";
const description =
  "You appear to be offline. Reconnect to continue browsing VANGULAR.";
---

<BaseLayout
  pageTitle={pageTitle}
  keywords={keywords}
  description={description}
  noindex={true}
>
  <main>
    <div class="container clear column flex-center">
      <h2>You're offline</h2>
      <p>
        Looks like you've lost your connection. No worries — your cart and
        settings are saved right on your device. Try again once you're back
        online.
      </p>
    </div>
    <div class="button-group">
      <button class="button button-primary" id="retry-offline">
        <span class="button-label">Try Again</span>
      </button>
      <a href="/home" class="button button-secondary">
        <span class="button-label">Back to Vangular</span>
      </a>
    </div>
  </main>
</BaseLayout>
