---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Newsletter Status| VANGULAR";
const keywords = "subscription success, newsletter confirmation";
const description =
  "You have successfully subscribed to the VANGULAR newsletter.";
---

<!-- I'd like to have a success footer here which highlights connecting
 on social media and signing up to newsletter -->
<BaseLayout
  pageTitle={pageTitle}
  keywords={keywords}
  description={description}
  noindex={true}
>
  <main>
    <div class="container column flex-center">
      <h3>Thanks for Subscribing!</h3>
      <br /><br />
      <p>
        You have successfully subscribed to our newsletter. Stay tuned for the
        latest updates and offers!
      </p>
    </div>
    <div class="button-group">
      <a href="/home" class="button button-primary">
        <span class="button-label">Back to Vangular</span>
      </a>
      <a href="javascript:window.close()" class="button button-primary">
        <span class="button-label">Close Window</span>
      </a>
    </div>
  </main>
</BaseLayout>
