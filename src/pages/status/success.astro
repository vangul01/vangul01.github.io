---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Order Success | VANGULAR";
const keywords =
  "order success, payment success, thank you, order confirmation";
const description =
  "Your VANGULAR order payment was successful and your confirmation is on the way.";
---

<!-- I'd like to have a success footer here which highlights connecting
 on social media and signing up to newsletter -->
<BaseLayout
  pageTitle={pageTitle}
  keywords={keywords}
  description={description}
  noindex={true}
>
  <main>
    <div class="container clear column flex-center">
      <h2>Your payment was successful :)</h2>
      <p>
        Thanks for your order! We've sent you a confirmation email with your
        purchase details.
      </p>
    </div>
    <div class="button-group">
      <a href="/home" class="button button-primary">
        <span class="button-label">Back to Vangular</span>
      </a>
    </div>
  </main>
</BaseLayout>
