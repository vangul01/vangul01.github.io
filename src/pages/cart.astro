---
import BaseLayout from "../layouts/BaseLayout.astro";
import CartIsland from "../components/CartIsland.jsx";
import missingProductFallback from "../assets/images/web/missing-product-fallback.png";

const pageTitle = "Cart | VANGULAR";
const keywords = "Cart, Shopping Cart, Checkout";
const description =
  "Review your VANGULAR cart, check item availability, and get ready for checkout when the shop is open.";

const checkoutDisabled = process.env.CHECKOUT_DISABLED === "true";
---

<!-- TO DO:
 on hover of image, have border change too
different colored dividers/other styling things, min width?
-->
<BaseLayout pageTitle={pageTitle} keywords={keywords} description={description}>
  <main>
    <section class="section">
      <div class="container clear column flex-center">
        <h1>Your Cart</h1>
        <br />
        {
          checkoutDisabled && (
            <>
              <h6>Checkout is coming soon.</h6>
              <p>
                We’re testing the shop before launch. Sign up for our newsletter
                to be notified when we open.
              </p>
              <a href="#newsletter-form" class="button button-secondary">
                <span class="button-label">Get Launch Updates</span>
              </a>
            </>
          )
        }
      </div>

      <CartIsland
        client:load
        fallbackImage={missingProductFallback.src}
        checkoutDisabled={checkoutDisabled}
      />
    </section>
  </main>
</BaseLayout>
