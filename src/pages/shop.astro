---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getAllProducts, getOptimizedImageUrl } from "../lib/sanity-client";
import missingProductFallback from "../assets/images/web/missing_product_fallback.png";

const products = await getAllProducts();

const pageTitle = "Shop | VANGULAR";
const keywords = "art prints, digital art, paintings, shop, store";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <section class="section">
      {
        products.length === 0 ? (
          <div class="container column flex-center">
            <h3>Check back soon for new products!</h3>
          </div>
        ) : (
          <div class="container grid-4" id="shop-grid" data-shop-grid>
            {products.map((product) => (
              <a
                href={`/products/${product.slug}`}
                class="shop-card is-loading"
                data-product-id={product._id}
                data-shop-card
                aria-busy="true"
              >
                <div class="shop-card-image img-skeleton">
                  <img
                    src={
                      product.images?.[0]
                        ? getOptimizedImageUrl(product.images[0], 400)
                        : missingProductFallback.src
                    }
                    alt={product.name}
                    loading="lazy"
                    data-fallback={missingProductFallback.src}
                    data-img-fade
                  />
                </div>

                <div class="shop-card-body">
                  <h4>{product.name}</h4>
                  <span class="product-badge" data-shop-badge hidden></span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
