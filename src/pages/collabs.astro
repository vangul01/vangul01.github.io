---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import logoFallback from "../assets/images/web/logo_eyewhites.png";

import { getCollabs, getOptimizedImageUrl } from "../lib/sanity-client";
// import type { Collab } from "../types/sanity-schema";

const collabs = await getCollabs();

const pageTitle = "Collabs | VANGULAR";
const keywords =
  "art, design, past work, projects, commission, creative, logos, collaborations, cover art";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <section class="section">
      {
        collabs.length === 0 ? (
          <div class="container column flex-center">
            <h3>
              We're having issues showing our collaborations at the moment.
              Please check back later!
            </h3>
          </div>
        ) : (
          <div class="container grid-4">
            {collabs.map((collab) =>
              collab.clientLink ? (
                <a class="link" href={collab.clientLink} target="_blank">
                  <div>
                    <img
                      src={
                        collab.images?.[0]
                          ? getOptimizedImageUrl(collab.images[0], 400)
                          : logoFallback.src
                      }
                      alt={collab.title}
                      loading="lazy"
                    />
                  </div>

                  <div>
                    <h4>{collab.title}</h4>
                  </div>
                </a>
              ) : (
                <div>
                  <div>
                    <img
                      src={
                        collab.images?.[0]
                          ? getOptimizedImageUrl(collab.images[0], 400)
                          : logoFallback.src
                      }
                      alt={collab.title}
                      loading="lazy"
                    />
                  </div>

                  <div>
                    <h4>{collab.title}</h4>
                  </div>
                </div>
              ),
            )}
          </div>
        )
      }

      <div class="container column flex-center">
        <h3>Want to collaborate?</h3>
        <br />
        <p>
          If you're interested in collaborating with me, please reach out via my
          contact page and we can discuss your project!
          <!-- <a class="link" href="/info/contact" target="_blank"> -->
          <!-- contact page -->
          <!-- </a> -->
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

