---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import aboutMe from "../assets/images/web/square-me.png";
import aboutVangular from "../assets/images/web/logo-fallback.png";

const pageTitle = "About | VANGULAR";
const keywords = "about, vangular, art, design";
const description =
  "Learn about VANGULAR, Valerie Angulo's art and design practice rooted in vibrant, existential, and playful storytelling.";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords} description={description}>
  <main>
    <section class="section">
      <div class="container grid-responsive">
        <div class="image-container img-skeleton">
          <Image
            src={aboutVangular}
            alt="Image of rainbow eye Vangular logo"
            data-fallback={aboutVangular.src}
            data-img-fade
          />
        </div>

        <div class="text-container">
          <h5>Welcome to Vangular!</h5>
          <br />
          <p>
            Vangular is artist and designer Val Angulo's creative brand. Rooted
            in curiosity and play, this online space brings together abstract
            art, colorful illustration, collage, poetry, and design, combining
            beauty with functionality to invite connection, joy and wonder. <br
            />
            <br />
            Vangular also collaborates with small businesses, fellow creatives, and
            organizations on visual identities, logos, and standalone pieces for individuals.
          </p>
        </div>
      </div>

      <div class="container grid-responsive reverse-layout">
        <div class="image-container img-skeleton">
          <Image
            src={aboutMe}
            alt="Image of the artist VANGULAR aka Valerie Angulo"
            data-fallback={aboutVangular.src}
            data-img-fade
          />
        </div>

        <div class="text-container">
          <h5>About the Artist</h5>
          <br />
          <p>
            Val Angulo is a New York-based multidisciplinary artist and software
            engineer working across painting, digital media, collage, and
            poetry. Using vivid color, organic forms, and eye-like motifs, she
            creates immersive visual worlds that feel warm, alive, and
            interconnected.<br />
            <br />
            If you’d like to inquire about commissions or collaborations, you can
            reach Val at <a class="link" href="mailto:contact@vangular.com"
              >contact@vangular.com</a
            > or reach out via the <span> </span>
            <a class="link" href="/info/contact" target="_blank">
              contact page</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
