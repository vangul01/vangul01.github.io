---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import aboutMe from "../assets/images/web/square_me.png";
import aboutVangular from "../assets/images/web/logo_eyewhites.png";

const pageTitle = "About | VANGULAR";
const keywords = "about, vangular, art, design";
---

<BaseLayout pageTitle={pageTitle} keywords={keywords}>
  <main>
    <section class="section">
      <div class="container grid-responsive">
        <div class="image-container">
          <Image src={aboutVangular} alt="Image of rainbow eye Vangular logo" />
        </div>

        <div class="text-container">
          <h5>Welcome to Vangular!</h5>
          <br />
          <p>
            Vangular is a New York-based creative studio by artist and designer
            Val Angulo. Rooted in curiosity and play, the studio brings together
            abstract art, colorful illustration, collage, poetry, and design,
            combining beauty with functionality to invite connection, joy and
            wonder. <br />
            <br />
            Vangular collaborates with small businesses, fellow creatives, and organizations
            on visual identities, logos, illustrations, and commissioned artwork.
          </p>
        </div>
      </div>

      <div class="container grid-responsive reverse-layout">
        <div class="image-container">
          <Image
            src={aboutMe}
            alt="Image of the artist VANGULAR aka Valerie Angulo"
          />
        </div>

        <div class="text-container">
          <h5>About the Artist</h5>
          <br />
          <p>
            Val Angulo is a New York-based multidisciplinary artist and software
            engineer working across painting, digital media, collage, and
            poetry. Using vivid color, organic forms, and eye-like motifs, she
            creates immersive visual worlds that feel warm, alive, and
            interconnected.<br />
            <br />
            If you’d like to inquire about commissions or collaborations, you can
            reach Val at contact@vangular.com or reach out via the
            <a class="link" href="/contact" target="_blank"> contact page</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
