---
import "/src/styles/global.css";
import favicon from "/favicon.ico";

interface Props {
  pageTitle: string;
  keywords: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  pageTitle,
  keywords,
  description = "Vangular is an art and design shop for vibrant, existential, and absurd original work, prints, and collaborations.",
  ogImage = "/images/preview-image.png",
  ogType = "website",
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const font =
  "https://fonts.googleapis.com/css2?family=Archivo+Black&family=Jost:wght@400;500;600;700&display=swap";
const fontAwesome =
  "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css";
---

<head>
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  />
  <meta name="color-scheme" content="dark light" />
  <meta name="generator" content={Astro.generator} />

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#190a2a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta
    name="apple-mobile-web-app-status-bar-style"
    content="black-translucent"
  />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Vangular" />
  <meta name="application-name" content="Vangular" />
  <!-- Apple Touch Icon -->
  <link rel="apple-touch-icon" href="/images/logo-eyewhites.png" />
  <!-- Manifest -->
  <link rel="manifest" href="/manifest.json" />

  <!-- Security headers (CSP located in netlify.toml) -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Opt out of Bing AI training -->
  <meta name="robots" content={noindex ? "noindex, nofollow" : "noarchive"} />

  <!-- Social media meta tags -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Vangular" />

  <!-- Twitter Card data -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />

  <link href={font} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={font} rel="stylesheet" /></noscript>
  <link
    href={fontAwesome}
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript><link href={fontAwesome} rel="stylesheet" /></noscript>
  <link href={favicon} rel="icon" type="image/x-icon" />

  <!-- PWA Icon -->
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/images/logo-eyewhites.png"
  />

  <meta name="author" content="Valerie Angulo" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <title>{pageTitle}</title>

  {
    import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src={
          import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ||
          "https://cloud.umami.is/script.js"
        }
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
      />
    )
  }
</head>
