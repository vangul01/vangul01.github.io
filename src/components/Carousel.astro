---
import { getOptimizedImageUrl } from "../lib/sanity-client";

export interface CarouselItem {
  image: string;
  title?: string;
  link?: string;
}

const { items = [], id = "carousel", interval = 5000 } = Astro.props;
const slides = items.filter((item) => item.image);
---

{
  slides.length > 0 && (
    <div
      class="carousel"
      data-carousel-id={id}
      data-interval={interval}
      data-slides={slides.length}
    >
      <div class="carousel-track">
        {slides.map((item, i) => (
          <div class="carousel-slide" data-index={i}>
            {item.link ? (
              <a href={item.link} class="carousel-slide-link">
                <img
                  src={getOptimizedImageUrl(item.image, 600)}
                  alt=""
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </a>
            ) : (
              <img
                src={getOptimizedImageUrl(item.image, 600)}
                alt=""
                loading={i === 0 ? "eager" : "lazy"}
              />
            )}
          </div>
        ))}
      </div>

      {slides.length > 1 && (
        <>
          <button class="carousel-btn carousel-prev" aria-label="Previous slide">
            ‹
          </button>
          <button class="carousel-btn carousel-next" aria-label="Next slide">
            ›
          </button>
          <div class="carousel-dots" role="tablist" aria-label="Slides">
            {slides.map((_, i) => (
              <button
                class="carousel-dot"
                data-index={i}
                role="tab"
                aria-label={`Go to slide ${i + 1}`}
                aria-selected={i === 0}
              ></button>
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<script>
  class Carousel {
    constructor(el) {
      this.el = el;
      this.track = el.querySelector(".carousel-track");
      this.slides = el.querySelectorAll(".carousel-slide");
      this.prevBtn = el.querySelector(".carousel-prev");
      this.nextBtn = el.querySelector(".carousel-next");
      this.dots = el.querySelectorAll(".carousel-dot");
      this.current = 0;
      this.interval = parseInt(el.dataset.interval) || 5000;

      if (this.slides.length < 2) return;

      this.prevBtn?.addEventListener("click", () => this.go(this.current - 1));
      this.nextBtn?.addEventListener("click", () => this.go(this.current + 1));
      this.dots.forEach((dot) =>
        dot.addEventListener("click", () =>
          this.go(parseInt(dot.dataset.index)),
        ),
      );

      this.el.addEventListener("mouseenter", () => this.stop());
      this.el.addEventListener("mouseleave", () => this.start());

      this.dots[0]?.classList.add("active");
      this.start();
    }

    go(index) {
      this.current =
        ((index % this.slides.length) + this.slides.length) %
        this.slides.length;
      this.track.style.transform = `translateX(-${this.current * 100}%)`;
      this.dots.forEach((dot, i) => {
        dot.classList.toggle("active", i === this.current);
        dot.setAttribute("aria-selected", i === this.current);
      });
    }

    start() {
      this.stop();
      this.timer = setInterval(() => this.go(this.current + 1), this.interval);
    }

    stop() {
      clearInterval(this.timer);
    }
  }

  document.querySelectorAll(".carousel").forEach((el) => new Carousel(el));
</script>
