---
import { getOptimizedImageUrl } from "../lib/sanity-client";

interface CarouselItem {
  image: string;
  title?: string;
  link?: string;
}

interface Props {
  items?: CarouselItem[];
  id?: string;
  interval?: number;
}

const { items = [], id = "carousel", interval = 5000 } = Astro.props;
const slides = items.filter((item) => item.image);
---

{
  slides.length > 0 && (
    <div
      class="carousel"
      data-carousel-id={id}
      data-interval={interval}
      data-slides={slides.length}
    >
      <div class="carousel-track">
        {slides.map((item, i) => (
          <div class="carousel-slide" data-index={i}>
            {item.link ? (
              <a href={item.link} class="carousel-slide-link">
                <img
                  src={getOptimizedImageUrl(item.image, 600)}
                  alt=""
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </a>
            ) : (
              <img
                src={getOptimizedImageUrl(item.image, 600)}
                alt=""
                loading={i === 0 ? "eager" : "lazy"}
              />
            )}
          </div>
        ))}
      </div>

      {slides.length > 1 && (
        <>
          <button
            class="carousel-btn carousel-prev"
            aria-label="Previous slide"
          >
            ‹
          </button>
          <button class="carousel-btn carousel-next" aria-label="Next slide">
            ›
          </button>
          <div class="carousel-dots" role="tablist" aria-label="Slides">
            {slides.map((_, i) => (
              <button
                class="carousel-dot"
                data-index={i}
                role="tab"
                aria-label={`Go to slide ${i + 1}`}
                aria-selected={i === 0}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<script>
  class Carousel {
    slides: NodeListOf<HTMLElement>;
    dots: NodeListOf<HTMLElement>;
    track: HTMLElement;
    current: number;
    interval: number;
    timer: ReturnType<typeof setInterval> | undefined;

    constructor(el: HTMLElement) {
      this.slides = el.querySelectorAll<HTMLElement>(".carousel-slide");
      this.dots = el.querySelectorAll<HTMLElement>(".carousel-dot");
      this.track = el.querySelector(".carousel-track")!;
      this.current = 0;
      this.interval = parseInt(el.dataset.interval || "", 10) || 5000;

      if (this.slides.length < 2) return;

      el.querySelector(".carousel-prev")?.addEventListener("click", () =>
        this.go(this.current - 1),
      );
      el.querySelector(".carousel-next")?.addEventListener("click", () =>
        this.go(this.current + 1),
      );

      this.dots.forEach((dot) => {
        const index = parseInt(dot.dataset.index || "", 10);
        if (!Number.isNaN(index)) {
          dot.addEventListener("click", () => this.go(index));
        }
      });

      el.addEventListener("mouseenter", () => this.stop());
      el.addEventListener("mouseleave", () => this.start());

      this.start();
    }

    go(index: number) {
      this.current =
        ((index % this.slides.length) + this.slides.length) %
        this.slides.length;
      this.track.style.transform = `translateX(-${this.current * 100}%)`;
      this.dots.forEach((dot, i) => {
        dot.classList.toggle("active", i === this.current);
        dot.setAttribute("aria-selected", String(i === this.current));
      });
    }

    start() {
      this.stop();
      this.timer = setInterval(() => this.go(this.current + 1), this.interval);
    }

    stop() {
      clearInterval(this.timer);
    }
  }

  document
    .querySelectorAll<HTMLElement>(".carousel")
    .forEach((el) => new Carousel(el));
</script>

<style>
  /* ------------------- CAROUSEL ----------------------- */
  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--border-radius-md);
    background-color: var(--color-gray-700);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-slide {
    min-width: 100%;
    position: relative;
  }

  .carousel-slide img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .carousel-slide-link {
    display: block;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(0, 0, 0, 0.4);
    color: var(--color-text-light);
    border: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--border-radius-circle);
    font-size: var(--font-size-clamp-lg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition:
      opacity var(--transition-fast),
      background var(--transition-fast);
    line-height: 1;
  }

  .carousel:hover .carousel-btn {
    opacity: 1;
  }

  .carousel-btn:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .carousel-prev {
    left: var(--spacing-clamp-sm);
  }

  .carousel-next {
    right: var(--spacing-clamp-sm);
  }

  .carousel-dots {
    position: absolute;
    bottom: var(--spacing-clamp-xs);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--spacing-clamp-xs);
    z-index: 2;
    padding: var(--spacing-clamp-xs);
  }

  .carousel-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--border-radius-circle);
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: transparent;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      transform var(--transition-fast);
    padding: 0;
  }

  .carousel-dot.active {
    background: var(--color-text-light);
    border-color: var(--color-text-light);
    transform: scale(1.3);
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.4);
  }
</style>
