---
import { getOptimizedImageUrl } from "../lib/sanity-client";

interface CarouselItem {
  productId?: string;
  image: string;
  title?: string;
  link?: string;
}

interface Props {
  items?: CarouselItem[];
  id?: string;
  interval?: number;
  fallback?: string;
  imageFallback?: string;
}

const {
  items = [],
  id = "carousel",
  interval = 5000,
  fallback = "",
  imageFallback = fallback,
} = Astro.props;
const slides = items.filter((item) => item.image);
---

{
  slides.length > 0 && (
    <div
      class="carousel"
      data-carousel-id={id}
      data-interval={interval}
      data-slides={slides.length}
      data-status-pending
    >
      <div class="carousel-track">
        {slides.map((item, i) => (
          <div
            class={`carousel-slide${i === 0 ? " active" : ""}`}
            data-index={i}
            data-product-id={item.productId}
          >
            {item.link ? (
              <a href={item.link} class="carousel-slide-link">
                <img
                  src={getOptimizedImageUrl(item.image, 600)}
                  alt={item.title || ""}
                  loading={i === 0 ? "eager" : "lazy"}
                  data-fallback={imageFallback || undefined}
                  data-img-fade
                />
              </a>
            ) : (
              <img
                src={getOptimizedImageUrl(item.image, 600)}
                alt={item.title || ""}
                loading={i === 0 ? "eager" : "lazy"}
                data-fallback={imageFallback || undefined}
                data-img-fade
              />
            )}
          </div>
        ))}
      </div>

      {fallback && (
        <img class="carousel-fallback" src={fallback} alt="" loading="lazy" />
      )}

      {slides.length > 1 && (
        <>
          <button
            class="carousel-btn carousel-prev"
            aria-label="Previous slide"
          >
            ‹
          </button>
          <button class="carousel-btn carousel-next" aria-label="Next slide">
            ›
          </button>
          <div class="carousel-dots" role="tablist" aria-label="Slides">
            {slides.map((_, i) => (
              <button
                class={`carousel-dot${i === 0 ? " active" : ""}`}
                data-index={i}
                role="tab"
                aria-label={`Go to slide ${i + 1}`}
                aria-selected={i === 0}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}
