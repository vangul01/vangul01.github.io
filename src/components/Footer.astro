---
import { getImage } from "astro:assets";
import { siteNavigation } from "../config/navigation";
import NewsletterForm from "./NewsletterForm.astro";

import plantieFooter from "../assets/images/web/footer-image.png";

const currentYear = new Date().getFullYear();
const footerLinks = siteNavigation.footerLinks;

const optimizedPlantie = await getImage({ src: plantieFooter, widths: [1600] });
---

<footer
  class="footer"
  style={`--footer-bg-url: url("${optimizedPlantie.src}");`}
>
  <!-- Row 2: Newsletter -->
  <div class="container clear">
    <div class="footer-newsletter">
      <h2>Stay Updated!</h2>
      <NewsletterForm />
    </div>
  </div>

  <!-- Row 3: Links (add clear after container so that its clear)-->
  <div class="container clear">
    <div class="footer-container column">
      <h2>Socials</h2>
      <!-- Row 1: Social Links -->
      <div class="footer-social">
        <ul class="social-links">
          {
            footerLinks.social.map(({ name, href, icon }) => (
              <a
                href={href}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={name}
              >
                <i class={`fa fa-${icon}`} />
              </a>
            ))
          }
        </ul>
      </div>
    </div>
    <h2>Links</h2>
    <div class="footer-links-row">
      <div class="footer-links-col">
        <ul class="link-list">
          {
            footerLinks.quickLinks.map(({ name, href }) => (
              <li>
                <a href={href} class="footer-link">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer-links-col">
        <ul class="link-list">
          {
            footerLinks.help.map(({ name, href }) => (
              <li>
                <a href={href} class="footer-link">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <p class="copyright">© {currentYear} VANGULAR. All rights reserved.</p>
  </div>
</footer>
