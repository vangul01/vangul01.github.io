---
import { getImage } from "astro:assets";
import Head from "../components/Head.astro";

import bgImage from "../assets/images/web/holographic-background.webp";
import bgImageDark from "../assets/images/web/holographic-background-darkmode.webp";

const { pageTitle, keywords, description, ogImage, ogType, noindex } =
  Astro.props;

const optimizedBg = await getImage({
  src: bgImage,
  format: "webp",
  widths: [1920],
});
const optimizedBgDark = await getImage({
  src: bgImageDark,
  format: "webp",
  widths: [1920],
});
---

<!doctype html>
<html lang="en">
  <Head
    pageTitle={pageTitle}
    keywords={keywords}
    description={description}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  <body
    style={`--bg-url: url("${optimizedBg.src}"); --bg-url-dark: url("${optimizedBgDark.src}");`}
  >
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div id="main-content" class="main-content-portal" tabindex="-1">
      <slot />
    </div>
    <script src="../scripts/image-handling.js"></script>
  </body>
</html>
