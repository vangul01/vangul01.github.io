# --- Build-time / public ---
SITE_URL=http://localhost:8888
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=development
PUBLIC_STRIPE_KEY=pk_test_xxxxxxxx
CLOUDFLARE_TOKEN=your_cloudflare_token

# --- Netlify functions (server-only) ---
STRIPE_KEY=sk_test_xxxxxxxx
STRIPE_CHECKOUT_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRODUCT_WEBHOOK_SECRET=whsec_xxxxxxxx
SECRET_SANITY_WEBHOOK_KEY=whsec_xxxxxxxx
SECRET_CATALOG_KEY=your_catalog_secret
# Optional
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxx
# Optional
SANITY_REBUILD_ON_PUBLISH=true

# Required only for Stripe -> Sanity provisioning and catalog repair.
# Not set on staging or in the local .env by default.
SANITY_WRITE_TOKEN=your_sanity_write_token

# --- Shipping ---
STRIPE_SHIPPING_RATE_STANDARD=shr_xxxxxxxx
STRIPE_SHIPPING_RATE_FREE=shr_xxxxxxxx

# --- Brevo ---
SECRET_BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_CONFIRMED_SUBSCRIBERS_LIST_ID=12345
BREVO_DEFAULT_DOUBLE_OPT_IN_TEMPLATE_ID=1
BREVO_CONTACT_AUTORESPONSE_TEMPLATE_ID=2
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=3
BREVO_ORDER_NOTIFICATION_TEMPLATE_ID=4
BREVO_NOTIFICATION_EMAIL=notify@example.com
BREVO_SENDER_EMAIL=shop@example.com
