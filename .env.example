SITE_URL='http://localhost:8888'
PUBLIC_STRIPE_KEY='pk_xxxxxxxxxxxx'
SECRET_STRIPE_KEY='sk_xxxxxxxxxxxx'
SECRET_STRIPE_WEBHOOK_SECRET='whsec_xxxxxxxxxxxx'

SANITY_PROJECT_ID='YOUR_PROJECT_ID'
PUBLIC_SANITY_DATASET='development'
SECRET_BREVO_API_KEY='xkeysib-xxxxxxxxxxxx'

# Cloudflare Web Analytics beacon token (from Cloudflare dashboard > Web Analytics)
CLOUDFLARE_TOKEN='YOUR_CF_ANALYTICS_TOKEN'

# Brevo (formerly Sendinblue) template and list related environment variables
BREVO_CONFIRMED_SUBSCRIBERS_LIST_ID='0'
BREVO_WELCOME_EMAIL_TEMPLATE_ID='0'
BREVO_DEFAULT_DOUBLE_OPT_IN_TEMPLATE_ID='0'
BREVO_CONTACT_AUTORESPONSE_TEMPLATE_ID='0'
BREVO_NOTIFICATION_EMAIL='contact@yourdomain.com'
# Verified Brevo sender email for customer-facing order emails (defaults to BREVO_NOTIFICATION_EMAIL if unset)
BREVO_SENDER_EMAIL='contact@yourdomain.com'
# Brevo email template IDs for order fulfillment emails (create templates in Brevo dashboard, then set these)
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID='0'
BREVO_ORDER_NOTIFICATION_TEMPLATE_ID='0'

# Stripe shipping rates (create in Stripe Dashboard > Shipping > Shipping rates, then set these)
STRIPE_SHIPPING_RATE_STANDARD='shr_xxxxxxxxxxxx'
STRIPE_SHIPPING_RATE_FREE='shr_xxxxxxxxxxxx'

# --- Catalog sync (Stripe <-> Sanity) ---
# Stripe: Dashboard > Developers > Webhooks > endpoint /.netlify/functions/stripe-product-sync
SECRET_STRIPE_PRODUCT_WEBHOOK_SECRET='whsec_xxxxxxxxxxxx'
# Sanity: sanity.io/manage > project > API > Tokens (write access)
SANITY_WRITE_TOKEN='sk_xxxxxxxxxxxx'
SANITY_PRODUCTION_DATASET='production'
SANITY_DEVELOPMENT_DATASET='development'
# Sanity: sanity.io/manage > project > webhooks (same secret for both dataset webhooks)
SECRET_SANITY_WEBHOOK_KEY='your-sanity-webhook-secret'
# Stripe API keys for the publish webhook (Dev/Test dataset -> sk_test, Production dataset -> sk_live)
SECRET_STRIPE_TEST_KEY='sk_test_xxxxxxxxxxxx'
SECRET_STRIPE_LIVE_KEY='sk_live_xxxxxxxxxxxx'
# Netlify: Site > Build & deploy > Build hooks > Add build hook
NETLIFY_BUILD_HOOK='https://api.netlify.com/build_hooks/xxxxxxxxxxxx'
# Set to "false" to disable automatic rebuilds on publish (for bulk edits); unset = enabled
NETLIFY_AUTO_REBUILD='false'
